generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  key         String   @unique // Código corto del proyecto, ej. "PROY-001"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modules     Module[]
  versions    Version[]
  testCases   TestCase[]
  testCycles  TestCycle[]
  executions  Execution[]
  defects     Defect[]
  uatApprovals UatApproval[]
  userProjects UserProject[]

  @@map("projects")
}

model Module {
  id          String   @id @default(uuid())
  name        String
  description String?
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  testCases   TestCase[]

  @@map("modules")
}

model Version {
  id          String   @id @default(uuid())
  name        String   // ej. "1.0.0", "2.1.3"
  description String?
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  testCycles  TestCycle[]
  testCases   TestCase[]
  uatApprovals UatApproval[]

  @@map("versions")
}

model TestCase {
  id          String   @id @default(uuid())
  title       String
  description String?
  preconditions String?
  steps       String   // JSON o texto con los pasos
  expectedResult String
  priority    String   @default("Medium") // Low, Medium, High, Critical
  type        String   @default("Functional") // Functional, UAT, Regression
  projectId   String
  moduleId    String?
  versionId   String?
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  module      Module?  @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  version     Version? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  executions  Execution[]

  @@map("test_cases")
}

model TestCycle {
  id          String   @id @default(uuid())
  name        String
  description String?
  projectId   String
  versionId   String
  startDate   DateTime?
  endDate     DateTime?
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version     Version  @relation(fields: [versionId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  executions  Execution[]

  @@map("test_cycles")
}

model Execution {
  id          String   @id @default(uuid())
  status      String   @default("Pending") // Pending, Passed, Failed, Blocked, NotRun
  evidence    String?  // URL o ruta al archivo de evidencia
  notes       String?
  executedBy  String   // Usuario que ejecutó la prueba
  executedAt  DateTime?
  testCaseId  String
  testCycleId String?
  projectId   String
  testCase    TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  testCycle   TestCycle? @relation(fields: [testCycleId], references: [id], onDelete: SetNull)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  defects     Defect[]

  @@map("executions")
}

model Defect {
  id          String   @id @default(uuid())
  title       String
  description String
  severity    String   @default("Medium") // Low, Medium, High, Critical
  status      String   @default("Open") // Open, InProgress, Resolved, Closed, Reopened
  projectId   String
  executionId String?
  reportedBy  String
  reportedAt  DateTime @default(now())
  resolvedAt  DateTime?
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  execution   Execution? @relation(fields: [executionId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("defects")
}

model User {
  id                String   @id @default(uuid())
  username          String   @unique
  email             String   @unique
  passwordHash      String
  fullName          String
  role              String   @default("User")
  roleId            String?
  roleRef           Role?    @relation(fields: [roleId], references: [id])
  status            String   @default("Active")
  mustChangePassword Boolean @default(false)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  uatApprovals      UatApproval[]
  sessions          Session[]
  projectAssignments UserProject[]

  @@map("users")
}

model UatApproval {
  id          String   @id @default(uuid())
  projectId   String
  versionId   String
  approvedBy  String
  approvedAt  DateTime
  comments    String?
  status      String   @default("Pending") // Pending, Approved, Rejected
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version     Version  @relation(fields: [versionId], references: [id])
  user        User     @relation(fields: [approvedBy], references: [id])
  createdAt   DateTime @default(now())

  @@map("uat_approvals")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String?
  userId    String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  section     String
  action      String
  description String?
  createdAt   DateTime @default(now())

  roles       RolePermission[]

  @@unique([section, action])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserProject {
  id        String   @id @default(uuid())
  userId    String
  projectId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, projectId])
  @@map("user_projects")
}

model RegistrationRequest {
  id            String   @id @default(uuid())
  username      String   @unique
  email         String   @unique
  passwordHash  String
  fullName      String
  status        String   @default("Pending")
  reviewedBy    String?
  reviewedAt    DateTime?
  roleAssigned  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("registration_requests")
}