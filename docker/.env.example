# ============================================================
# TestService - Variables de entorno para Docker Compose
# ============================================================
# Copiar a .env y configurar valores reales
# NUNCA subir .env al repositorio
# Permisos recomendados: chmod 600 .env
# ============================================================

# Base de datos PostgreSQL (OBLIGATORIO - sin valores por defecto inseguros)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=testing_uat

# Aplicacion (OBLIGATORIO)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_PORT=3000