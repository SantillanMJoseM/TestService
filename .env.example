# Configuración de la aplicación
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=TestService

# Base de datos PostgreSQL (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/testservice?schema=public"

# Sesión / autenticación (cambiar en producción por un valor seguro)
NEXTAUTH_SECRET=tu-secreto-de-sesion-cambiar-en-produccion
NEXTAUTH_URL=http://localhost:3000

# Puerto de la aplicación
PORT=3000