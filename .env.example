# Variables de entorno para TestService
# Copiar a .env y configurar valores reales
# NO subir .env al repositorio

# Base de datos PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=testing_uat

# Aplicación
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_PORT=3000

# Base de datos (construida automáticamente desde las variables anteriores)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/testing_uat?schema=public