# Configuración de la aplicación
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=TestService

# Base de datos PostgreSQL (Prisma) - Servidor remoto 192.168.1.23:5432
# Reemplazar 'tu_password' con la contraseña real del usuario postgres
DATABASE_URL="postgresql://postgres:tu_password@192.168.1.23:5432/testing_uat?schema=public"

# Sesión / autenticación (cambiar en producción por un valor seguro)
NEXTAUTH_SECRET=tu-secreto-de-sesion-cambiar-en-produccion
NEXTAUTH_URL=http://localhost:3000

# Puerto de la aplicación
PORT=3000