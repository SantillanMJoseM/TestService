# ============================================================
# TestService - Variables de entorno
# ============================================================
# Copiar a .env y configurar valores reales.
# NUNCA subir .env al repositorio.
# Permisos recomendados: chmod 600 .env
# ============================================================

# ------------------------------------------------------------
# Base de datos PostgreSQL
# ------------------------------------------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=testing_uat

# ------------------------------------------------------------
# Aplicacion
# ------------------------------------------------------------
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_PORT=3000

# ------------------------------------------------------------
# Base de datos (construida automaticamente por Docker Compose)
# No modificar manualmente - se genera desde las variables anteriores
# ------------------------------------------------------------
# DATABASE_URL=postgresql://postgres:password@postgres:5432/testing_uat?schema=public